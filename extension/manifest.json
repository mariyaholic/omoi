{
  "manifest_version": 3,
  "name": "Omoi companion (development)",
  "version": "0.2.0",
  "description": "Record opted-in video playback in your local Omoi catalogue.",
  "permissions": ["nativeMessaging", "storage", "scripting", "alarms"],
  "optional_host_permissions": ["https://www.youtube.com/*", "https://www.netflix.com/*", "https://www.twitch.tv/*", "https://www.bilibili.com/*", "https://www.primevideo.com/*", "https://www.disneyplus.com/*", "https://www.crunchyroll.com/*"],
  "background": {"service_worker": "worker.js"},
  "action": {"default_popup": "popup.html"},
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'"}
}
